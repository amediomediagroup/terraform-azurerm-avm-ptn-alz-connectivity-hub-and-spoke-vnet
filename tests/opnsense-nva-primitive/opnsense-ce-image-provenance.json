  "build_steps": [
    "1. Download OPNsense-26.7-nano-amd64.img.bz2 from official mirror",
    "2. Verify SHA256 against checksums file",
    "3. bunzip2 to OPNsense-26.7-nano-amd64.img",
    "4. qemu-img convert -f raw -O vpc -o subformat=fixed,force_size -> .vhd",
    "5. Patch VHD footer CHS geometry per Microsoft VHD spec (C=6241 H=16 S=63)",
    "6. Update VHD footer checksum",
    "7. az storage blob upload (PageBlob) to aegisopnsensevhd0929/vhds",
    "8. az disk create --hyper-v-generation V1 --os-type Linux --source blob",
    "9. Inject config.xml: enable SSH, permit root login, authorized key, WAN/DHCP",
    "10. Boot VM, verify: opnsense-version 26.7, FreeBSD 15.1-RELEASE-p1, hn0/Hyper-V NIC, net.inet.ip.forwarding=1, pfctl enabled",
    "11. pkg install azure-agent (WALinuxAgent 2.15.0.1)",
    "12. sysrc waagent_enable=YES",
    "13. waagent -deprovision+user -force",
    "14. az vm deallocate + az vm generalize",
    "15. az image create --hyper-v-generation V1 (managed image)",
    "16. az sig image-version create -> gallery version 1.0.0",
    "17. Fix waagent.conf: OS.SshDir=/etc/ssh \u2192 /usr/local/etc/ssh (pkg install writes Linux default; FreeBSD path is /usr/local/etc/ssh)",
    "18. Re-deprovision, re-capture \u2192 opnsense-26-7-ce-v2 \u2192 gallery version 1.0.1"
  ],
